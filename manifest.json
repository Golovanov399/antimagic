{
  "manifest_version": 3,
  "name": "Antimagic",
  "version": "1.5.2",

  "description": "Shows actual cf users colors.",

  "icons": {
    "48": "icons/antimagic-48.png",
    "96": "icons/antimagic-96.png",
    "128": "icons/antimagic-128.png"
  },

  "permissions": [
    "activeTab",
    "storage"
  ],

  "background": {
    "service_worker": "background_chrome.js",
    "scripts": ["background.js"]
  },

  "content_scripts": [
    {
      "matches": ["*://codeforces.com/*"],
      "js": ["antimagic.js"]
    }
  ],
  
  "host_permissions": ["https://api.github.com/*", "https://gist.github.com/*"],

  "browser_specific_settings": {
    "gecko": {
      "id": "{edc5784d-d7c2-4e32-bbe1-4701133357d5}",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
